  {
    "name": "part-address",
    "w": 1280,
    "h": 800,
    "theme": "light",
    "steps": [
      {
        "js": "location.hash='part=tf'; location.reload()"
      },
      {
        "wait": 3500
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "arrival.js"
        ]
      }
    ]
  },
  {
    "name": "keyboard",
    "w": 1280,
    "h": 800,
    "theme": "light",
    "steps": [
      {
        "jsFile": "settled.js"
      },
      {
        "js": "document.getElementById('tsExplore').focus()"
      },
      {
        "keys": [
          "Tab"
        ]
      },
      {
        "js": "window.__keyPhase=\"learn\""
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "keyboard.js"
        ]
      },
      {
        "keys": [
          "Enter",
          "Tab"
        ]
      },
      {
        "js": "window.__keyPhase=\"run\""
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "keyboard.js"
        ]
      },
      {
        "keys": [
          "Enter"
        ]
      },
      {
        "wait": 700
      },
      {
        "js": "window.__keyPhase=\"desk\""
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "keyboard.js"
        ]
      },
      {
        "keys": [
          "Tab"
        ]
      },
      {
        "js": "window.__keyPhase=\"part\""
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "keyboard.js"
        ]
      },
      {
        "keys": [
          "Enter"
        ]
      },
      {
        "wait": 1800
      },
      {
        "js": "window.__keyPhase=\"inspect\""
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "keyboard.js"
        ]
      }
    ]
  },
  {
    "name": "phone-touch",
    "w": 390,
    "h": 844,
    "mobile": true,
    "theme": "light",
    "steps": [
      {
        "jsFile": "settled.js"
      },
      {
        "tap": "(()=>{const r=document.getElementById('tsLearn').getBoundingClientRect();return [r.x+r.width/2,r.y+r.height/2]})()"
      },
      {
        "jsFile": [
          "settled.js",
          "common.js",
          "phone.js"
        ]
      },
      {
        "shot": "phone"
      }
    ]
  },
